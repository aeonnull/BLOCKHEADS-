{
  "rewrites": [
    { "source": "/holders",     "destination": "/api/holders" },
    { "source": "/game",        "destination": "/api/game" },
    { "source": "/leaderboard", "destination": "/api/leaderboard" }
  ],
  "functions": {
    "api/verify.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
